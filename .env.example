# Copy to .env and fill in. Never commit .env.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
REED_API_KEY=your_reed_api_key
DATABASE_URL=postgresql://user:password@localhost:5432/jobfit

# Weekly digest (Phase 5). Only needed to actually send email.
# Resend is the default: free forever at 3,000 emails a month.
# Without a verified domain, leave DIGEST_FROM_EMAIL blank and the digest is
# sent from onboarding@resend.dev, which only delivers to the email address
# your Resend account was created with. Set DIGEST_TO_EMAIL to that address.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
DIGEST_TO_EMAIL=the_email_you_signed_up_to_resend_with
DIGEST_FROM_EMAIL=

# Optional alternative. SendGrid no longer has a free plan.
# SENDGRID_API_KEY=your_sendgrid_api_key
